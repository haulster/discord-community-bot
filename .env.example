# ============================================================
#  CONFIGURATION DU BOT — copier ce fichier vers .env :
#  cp .env.example .env
#  puis remplir les valeurs. NE JAMAIS COMMITER LE FICHIER .env
# ============================================================

# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID de l'application (Developer Portal > General Information > Application ID)
CLIENT_ID=

# ID Discord du propriétaire principal (Root Owner) — ne peut jamais être retiré
ROOT_OWNER_ID=

# Base de données SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:./bot.db"

# Préfixe des commandes
BOT_PREFIX=+

# Statut de présence : online | idle | dnd | invisible
BOT_STATUS=online

# Activité affichée
BOT_ACTIVITY=+help

# Type d'activité : Playing | Watching | Listening | Competing | Streaming
BOT_ACTIVITY_TYPE=Watching

# Statut rotatif (true/false) — les statuts sont définis dans src/config/status.ts
BOT_STATUS_ROTATION=false

# Intervalle de rotation en secondes (minimum 10)
BOT_STATUS_ROTATION_INTERVAL=30

# Couleur principale des embeds (hexadécimal)
EMBED_COLOR=#5865F2
